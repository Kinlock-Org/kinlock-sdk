# Names and safe placeholders only. Never commit real values.
DATABASE_URL=postgres://kinlock:kinlock@localhost:5432/kinlock
# Comma-separated; at least two in deployed environments.
STELLAR_RPC_URLS=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
KINLOCK_CONTRACT_ID=
# Where ingestion starts when no cursor is stored: at or before the contract's first event.
KINLOCK_START_LEDGER=
POLL_INTERVAL_MS=5000
# /health returns 503 (lagging) beyond this many ledgers behind the chain tip.
MAX_LAG_LEDGERS=60
PORT=3001
